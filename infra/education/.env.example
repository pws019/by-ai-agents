# 复制为 .env 后使用: cp .env.example .env
# .env 已被 .gitignore；下面的值仅为本地开发占位，不要用于任何共享环境。

# --- 数据服务（compose.yaml）---
POSTGRES_USER=edu
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=education
POSTGRES_PORT=5433
NEO4J_PASSWORD=dev-only-change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# 宿主 6333 可能被 legacy customer-qdrant 使用，教育 Qdrant 默认 6335
QDRANT_HTTP_PORT=6335

# --- 应用（M1+ 使用）---
# 模式：mock = 无需 GPU/真实模型，仅用于开发与编排测试；real = 真实模型，用于模型评估。
# 两种模式的结果必须分开报告，mock 通过不等于真实模型通过。
EDUCATION_MODE=mock
# 内部服务间认证密钥（BFF -> Agent）。用 `openssl rand -hex 32` 生成，禁止提交
INTERNAL_AUTH_SECRET=
# real 模式才需要；留空即不可用
MODEL_BASE_URL=
MODEL_API_KEY=
EMBEDDING_BASE_URL=
