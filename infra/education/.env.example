# 复制为 .env 后使用: cp .env.example .env
# .env 已被 .gitignore；下面的值仅为本地开发占位，不要用于任何共享环境。

# --- 数据服务（compose.yaml）---
POSTGRES_USER=edu
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=education
POSTGRES_PORT=5433
NEO4J_PASSWORD=dev-only-change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# 宿主 6333 可能被 legacy customer-qdrant 使用，教育 Qdrant 默认 6335
QDRANT_HTTP_PORT=6335

# --- 应用（M1+ 使用）---
# 模式：mock = 无需 GPU/真实模型，仅用于开发与编排测试；real = 真实模型，用于模型评估。
# 两种模式的结果必须分开报告，mock 通过不等于真实模型通过。
EDUCATION_MODE=mock
# 内部服务间认证密钥（BFF -> Agent）。用 `openssl rand -hex 32` 生成，禁止提交
INTERNAL_AUTH_SECRET=
# real 模式才需要；留空即不可用（三项都要填）
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 服务之间互相找到对方：education-api 调 Agent；Agent 回调业务 API
AGENT_BASE_URL=http://127.0.0.1:8500
AGENT_PORT=8500
BUSINESS_API_URL=http://127.0.0.1:8400
# 前端页面的来源（education-api 的跨站写防护用），默认即下面的值
ALLOWED_ORIGIN=http://localhost:5173
# npm run dev 会自动加载本文件的本地副本；内部密钥留空时首次启动会自动生成。
# 单独启动 education-api / education-agent 时，仍需先加载：set -a; source infra/education/.env; set +a
# turbo.json 已把这些变量列入 dev 任务的 passThroughEnv。
# T-26 索引任务：EDUCATION_MODE=real 时，留空即直连本地 customer-embedding-demo
# （Qwen3-Embedding-0.6B，1024 维，`npm run dev --workspace=customer-embedding-demo`，默认端口 8080，
# 不需要 key）；要换成云端 embedding 服务才需要填这三个。mock 模式用 MockEmbedder，不发任何真实请求。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
# education-agent 直连本地 Qdrant（见上面 QDRANT_HTTP_PORT），生产环境用 EDUCATION_QDRANT_URL 覆盖。
